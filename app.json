{
  "expo": {
    "name": "AVIA",
    "slug": "avia",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avia.app"
    },
    "android": {
      "package": "com.avia.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#5B5BD6",
      "description": "Organize compromissos e prazos com lembretes automáticos."
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B5BD6"
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O AVIA usa o microfone para transformar sua fala em um item.",
          "speechRecognitionPermission": "O AVIA usa o reconhecimento de fala para transformar sua fala em um item."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "O AVIA usa o calendário para colocar suas tarefas na Google Agenda, se você ativar essa opção.",
          "remindersPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "35a3ff3d-5162-4e03-b3ea-d51a24890046"
      }
    },
    "owner": "evandro1984"
  }
}
