# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Cloudflare Workers
.wrangler/

# Segredos (chave de API do backend — veja src/sync/secrets.example.ts)
src/sync/secrets.ts

# Firebase (push notifications) — google-services.json é config do projeto,
# a chave de conta de serviço (*firebase-adminsdk*.json) é credencial secreta.
# Nenhum dos dois deve ir pro repositório.
google-services.json
*firebase-adminsdk*.json

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# builds baixados localmente + tokens salvos à mão — nunca devem entrar
# em pacote nenhum (git ou build da EAS)
*.apk
*.aab
aviatoken.txt

# Backups do D1 (wrangler d1 export) — têm os dados de TODOS os usuários;
# nunca podem ir pro Git nem pro pacote do build.
backup-*.sql
# Backups cifrados (scripts/backup) — ficam fora do projeto, mas por via das dúvidas.
*.aviabkp

# Segredos de teste do wrangler dev (worker/.dev.vars)
.dev.vars

# Anotações pessoais com dados de contas de teste
conta teste avia.txt
